# Offline demo: leave DEMO_MODE=true. No WhatsApp account or API key is needed.
DEMO_MODE=true

# Optional in demo mode. With a key, Claude writes replies; without one, a scripted brain does.
ANTHROPIC_API_KEY=
LEAD_BOT_MODEL=claude-opus-5-5

# Required when DEMO_MODE=false (from your own Meta app)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
ADMIN_PASSWORD=

# Business owner's WhatsApp number, digits only with country code
OWNER_PHONE=
# Approved template for owner alerts. Needs one body variable. Without it, alerts are plain
# text, which WhatsApp only delivers inside a 24-hour customer service window.
OWNER_ALERT_TEMPLATE=
OWNER_ALERT_TEMPLATE_LANG=en

# Optional: POST each qualified lead as JSON to n8n, Zapier, a CRM or Apps Script
LEAD_WEBHOOK_URL=

DATABASE_PATH=leadbot.db
BUSINESS_PROFILE=business_profile.json
MAX_BOT_TURNS=12
